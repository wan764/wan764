# ── RPC Endpoints ──────────────────────────────────────────────
# Use a premium RPC for low-latency sniping (Helius, QuickNode, Triton)
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_WS_ENDPOINT=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ── Wallet ─────────────────────────────────────────────────────
# Base-58 encoded private key of your sniper wallet
PRIVATE_KEY=YOUR_PRIVATE_KEY_BASE58

# ── Jito MEV Bundles (optional but strongly recommended) ───────
USE_JITO=true
JITO_TIP_LAMPORTS=100000
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# ── Snipe Settings ─────────────────────────────────────────────
BUY_AMOUNT_SOL=0.1
MAX_SLIPPAGE_BPS=1500
COMPUTE_UNIT_PRICE=100000
COMPUTE_UNIT_LIMIT=300000

# ── Which DEXes to monitor ─────────────────────────────────────
ENABLE_RAYDIUM_AMM=true
ENABLE_RAYDIUM_CPMM=true
ENABLE_ORCA=true
ENABLE_METEORA_DLMM=true
ENABLE_METEORA_DAMMV2=true

# ── Filters ────────────────────────────────────────────────────
MIN_POOL_LIQUIDITY_SOL=1.0
# Comma-separated quote mints (WSOL and USDC by default)
QUOTE_MINTS=So11111111111111111111111111111111111111112,EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
REJECT_MINT_AUTHORITY=true
REJECT_FREEZE_AUTHORITY=true

# ── Auto-Sell / Position Management ───────────────────────────
AUTO_SELL=true
TAKE_PROFIT_X=2.0
STOP_LOSS_X=0.5
MAX_HOLD_SECS=300
POSITION_CHECK_MS=5000
